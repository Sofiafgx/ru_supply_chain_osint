# Отримайте власні реквізити на https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Необов'язково: номер для першого входу; без нього програма запитає в терміналі.
TELEGRAM_PHONE=
# Файл сесії створюється після входу. Шлях відносно кореня проєкту.
TELEGRAM_SESSION=data/telegram/account

# Власні API-ключі для реєстрів; не додавайте їх до URL.
CHECKO_API_KEY=
CLEARSPENDING_API_KEY=
# Необов'язково: один власний HTTP/SOCKS-проксі для sources_cli.py.
OSINT_PROXY=

# Історичний збір X / Threads через власний офіційний API-доступ.
X_BEARER_TOKEN=
THREADS_ACCESS_TOKEN=
